{
  "name": "tourny",
  "private": true,
  "version": "2.0.4",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "build:host": "pnpm build:server && vite build --base /",
    "host": "pnpm build:host && node dist-server/server.js",
    "preview": "vite preview",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "if command -v git >/dev/null 2>&1; then git config core.hooksPath .githooks; fi"
  },
  "dependencies": {
    "@reduxjs/toolkit": "latest",
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-redux": "latest",
    "react-router-dom": "latest",
    "tailwindcss": "latest",
    "@tailwindcss/vite": "latest",
    "lucide-react": "latest",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "latest",
    "babel-plugin-react-compiler": "latest",
    "oxlint": "latest",
    "typescript": "latest",
    "prettier": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/node": "latest",
    "@types/qrcode": "^1.5.6"
  }
}
