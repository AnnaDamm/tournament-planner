#!/usr/bin/env bash

set -euo pipefail

script_directory="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
project_directory="$(cd "$script_directory/.." && pwd)"
cd "$project_directory"

project_hash="$(printf '%s' "$project_directory" | cksum | awk '{print $1}')"
compose_project="${TOURNY_COMPOSE_PROJECT:-tourny-${project_hash}}"

is_private_ipv4() {
  case "$1" in
    10.* | 192.168.*) return 0 ;;
    172.*)
      second_octet="${1#172.}"
      second_octet="${second_octet%%.*}"
      [ "$second_octet" -ge 16 ] && [ "$second_octet" -le 31 ]
      return
      ;;
  esac
  return 1
}

find_macos_address() {
  for interface in $(networksetup -listallhardwareports 2>/dev/null | awk '/Device:/{print $2}'); do
    address="$(ipconfig getifaddr "$interface" 2>/dev/null || true)"
    if is_private_ipv4 "$address"; then
      printf '%s\n' "$address"
      return
    fi
  done
}

is_virtual_interface() {
  case "$1" in
    lo | docker* | br-* | bridge* | veth* | vether* | virbr* | podman* | cni* | flannel* | kube* | tun* | tap* | wg* | zt*) return 0 ;;
  esac
  return 1
}

is_wifi_interface() {
  case "$1" in
    wl* | wlan*) return 0 ;;
  esac
  return 1
}

get_interface_address() {
  ip -o -4 addr show dev "$1" scope global 2>/dev/null |
    awk 'NR == 1 {sub(/\/.*/, "", $4); print $4}'
}

find_linux_address() {
  command -v ip >/dev/null 2>&1 || return

  interface="$(ip route show default 2>/dev/null | awk 'NR == 1 {print $5}')"
  if [ -n "$interface" ] && ! is_virtual_interface "$interface"; then
    address="$(get_interface_address "$interface")"
    if is_private_ipv4 "$address"; then
      printf '%s\n' "$address"
      return
    fi
  fi

  for prefer_wifi in true false; do
    while read -r interface address; do
      is_virtual_interface "$interface" && continue
      if [ "$prefer_wifi" = true ] && ! is_wifi_interface "$interface"; then
        continue
      fi
      if is_private_ipv4 "$address"; then
        printf '%s\n' "$address"
        return
      fi
    done < <(
      ip -o -4 addr show scope global 2>/dev/null |
        awk '{interface=$2; sub(/@.*/, "", interface); address=$4; sub(/\/.*/, "", address); print interface, address}'
    )
  done
}

is_port_available() {
  (echo >/dev/tcp/127.0.0.1/"$1") >/dev/null 2>&1 && return 1
  return 0
}

find_available_port() {
  candidate=8080
  while [ "$candidate" -le 8180 ]; do
    if is_port_available "$candidate"; then
      printf '%s\n' "$candidate"
      return
    fi
    candidate=$((candidate + 1))
  done

  echo "No available port found between 8080 and 8180. Set TOURNY_PORT manually." >&2
  return 1
}

get_viewer_port() {
  address="${1#*://}"
  address="${address%%/*}"
  case "$address" in
    *:*) printf '%s\n' "${address##*:}" ;;
    *) printf '%s\n' 80 ;;
  esac
}

viewer_url="${TOURNY_VIEWER_URL:-}"
port="${TOURNY_PORT:-}"
if [ -n "$viewer_url" ]; then
  viewer_port="$(get_viewer_port "$viewer_url")"
  case "$viewer_port" in
    *[!0-9]* | '')
      echo "TOURNY_VIEWER_URL must contain a valid port." >&2
      exit 1
      ;;
  esac
  if [ -n "$port" ] && [ "$port" != "$viewer_port" ]; then
    echo "TOURNY_PORT must match the port in TOURNY_VIEWER_URL." >&2
    exit 1
  fi
  port="$viewer_port"
fi
if [ -z "$port" ]; then
  port="$(find_available_port)"
fi

if [ -z "$viewer_url" ]; then
  case "$(uname -s)" in
    Darwin) address="$(find_macos_address)" ;;
    Linux) address="$(find_linux_address)" ;;
    *)
      echo "Unsupported host system. Set TOURNY_VIEWER_URL manually." >&2
      exit 1
      ;;
  esac
  if [ -z "$address" ]; then
    echo "No private LAN IPv4 address found. Set TOURNY_VIEWER_URL manually." >&2
    exit 1
  fi
  viewer_url="http://${address}:${port}/"
fi

if [ -z "${VITE_APP_VERSION:-}" ]; then
  VITE_APP_VERSION="$({
    git describe --tags --exact-match --match 'v[0-9]*' HEAD 2>/dev/null ||
    git describe --tags --abbrev=0 --first-parent --match 'v[0-9]*' HEAD 2>/dev/null ||
    true
  })"
  export VITE_APP_VERSION
fi

if [ "${1:-}" = "--print-url" ]; then
  printf '%s\n' "$viewer_url"
  exit 0
fi

export TOURNY_PORT="$port"
export TOURNY_VIEWER_URL="$viewer_url"

echo "Compose project: $compose_project"
echo "Viewer URL: $viewer_url"
exec docker compose --project-name "$compose_project" --profile production up --build host "$@"
